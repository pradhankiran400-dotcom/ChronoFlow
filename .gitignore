# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example

# =========================
# Root Python files (break Vercel detection)
# =========================
/main.py
/pyproject.toml


# =========================
# Python Cache
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual Environment
# =========================
venv/
.venv/
env/

# =========================
# Python Build Files
# =========================
build/
dist/
*.egg-info/

# =========================
# Node Modules
# =========================
node_modules/

# =========================
# Frontend Build Files
# =========================
